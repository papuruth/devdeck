{
    "name": "devdeck",
    "description": "A free, open-source, all-in-one developer toolbox — 22 utilities available in a single progressive web app, with dark mode, search, and offline support.",
    "version": "2.1.0",
    "private": true,
    "license": "MIT",
    "homepage": "https://devdeckio.netlify.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/papuruth/devdeck.git"
    },
    "bugs": {
        "url": "https://github.com/papuruth/devdeck/issues"
    },
    "keywords": [
        "developer-tools",
        "toolbox",
        "pwa",
        "utilities",
        "react",
        "nextjs",
        "open-source",
        "offline",
        "dark-mode"
    ],
    "engines": {
        "node": ">=22.0.0",
        "yarn": ">=1.22.0"
    },
    "packageManager": "yarn@1.22.22",
    "resolutions": {
        "@mui/styled-engine": "npm:@mui/styled-engine-sc@latest"
    },
    "author": {
        "name": "Papu Kumar",
        "email": "papuruth@gmail.com",
        "url": "https://p-folio.netlify.app"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "prettier": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
        "format": "yarn prettier && yarn lint --fix",
        "analyze": "ANALYZE=true yarn build",
        "typecheck": "tsc --noEmit"
    },
    "browserslist": {
        "production": [
            ">0.01%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx}": [
            "yarn format",
            "git add ."
        ]
    },
    "dependencies": {
        "@emotion/is-prop-valid": "^1.3.1",
        "@fontsource/roboto": "^4.5.8",
        "@microlink/react-json-view": "^1.31.18",
        "@mui/base": "^5.0.0-beta.69",
        "@mui/icons-material": "latest",
        "@mui/lab": "latest",
        "@mui/material": "latest",
        "@mui/styled-engine-sc": "latest",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.3.4",
        "crypto-js": "^4.2.0",
        "date-fns": "^4.1.0",
        "diff": "^9.0.0",
        "js-yaml": "^4.1.1",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "next": "^15.3.0",
        "nprogress": "^0.2.0",
        "papaparse": "^5.5.3",
        "qrcode": "^1.5.1",
        "react": "^18.3.1",
        "react-confirm-alert": "^3.0.6",
        "react-day-picker": "^9.14.0",
        "react-dom": "^18.3.1",
        "react-dropzone": "^14.2.3",
        "react-image-crop": "^10.1.5",
        "react-is": "^18.3.1",
        "react-localization": "^1.0.19",
        "react-redux": "^9.1.0",
        "react-toastify": "^10.0.5",
        "redux": "^5.0.1",
        "redux-saga": "^1.3.0",
        "redux-thunk": "^3.1.0",
        "reduxsauce": "^1.2.1",
        "seamless-immutable": "^7.1.4",
        "styled-components": "^6.1.13",
        "styled-media-query": "^2.1.2",
        "workbox-core": "^7.1.0",
        "workbox-expiration": "^7.1.0",
        "workbox-precaching": "^7.1.0",
        "workbox-routing": "^7.1.0",
        "workbox-strategies": "^7.1.0",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^17.5.1",
        "@commitlint/config-conventional": "^17.4.4",
        "@netlify/plugin-nextjs": "^5.15.11",
        "@next/bundle-analyzer": "^15.3.0",
        "@types/crypto-js": "^4.2.2",
        "@types/diff": "^5.2.1",
        "@types/js-yaml": "^4.0.9",
        "@types/lodash": "^4.17.0",
        "@types/minimatch": "^5.1.2",
        "@types/node": "^22.0.0",
        "@types/nprogress": "^0.2.3",
        "@types/papaparse": "^5.3.14",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@types/styled-components": "^5.1.34",
        "@types/zxcvbn": "^4.4.4",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-config-next": "^15.3.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-jsx-a11y": "^6.7.1",
        "eslint-plugin-react": "^7.32.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "husky": "^8.0.3",
        "lint-staged": "^13.2.0",
        "prettier": "^3.3.3",
        "typescript": "^5.5.4",
        "workbox-webpack-plugin": "^7.1.0"
    }
}
